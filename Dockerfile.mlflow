# Dockerfile.mlflow
# ─────────────────────────────────────────────────────────────
# Dedicated MLflow tracking server container.
# Both training (later) and the API talk to this over HTTP,
# instead of sharing a raw SQLite file across containers.
# ─────────────────────────────────────────────────────────────
FROM python:3.11-slim

RUN pip install --no-cache-dir mlflow==3.14.0

WORKDIR /mlflow

EXPOSE 5000

CMD ["mlflow", "server", \
     "--host", "0.0.0.0", \
     "--port", "5000", \
     "--backend-store-uri", "sqlite:////mlflow/data/mlflow.db", \
     "--default-artifact-root", "/mlflow/artifacts", \
     "--allowed-hosts", "localhost,127.0.0.1,mlflow,localhost:5000,127.0.0.1:5000,mlflow:5000"]